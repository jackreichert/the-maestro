{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["esnext"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "skipLibCheck": false,
    "allowJs": false,
    "checkJs": false
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["scripts/web/client/src", "scripts/web/client/dist", "scripts/web/client/test/dom-harness.ts", "scripts/web/client/test/*.dom.test.ts"]
}
